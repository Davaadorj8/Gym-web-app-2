generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  role          String    @default("staff")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  accounts      Account[]
  sessions      Session[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Member {
  id               String    @id @default(cuid())
  firstName        String
  lastName         String
  email            String    @unique
  phone            String
  dob              String?
  gender           String?
  photoUrl         String?
  emergencyContact String?
  medicalNotes     String?

  // Membership Details
  planTitle        String
  planCategory     String    @default("over18")
  durationMonths   Int
  startDate        DateTime
  expirationDate   DateTime
  status           String    @default("Active")
  isOrganization   Boolean   @default(false)
  orgName          String?

  // Live Gym Operations
  occupancyStatus  String    @default("Checked Out")
  assignedLocker   String?
  lastCheckInTime  DateTime?

  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  extensionLogs    MembershipExtensionLog[]
}

model Plan {
  id                 String   @id @default(cuid())
  categoryTarget     String   // under18, over18, organization
  title              String
  titleMn            String?
  specializedLessons String?
  durationMonths     Int
  price              Float
  isCustom           Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model LockerLog {
  id               String   @id @default(cuid())
  lockerNumber     String
  memberId         String
  memberName       String
  eventType        String   // Checked In, Checked Out
  eventDescription String
  timestamp        DateTime @default(now())
  timeFormatted    String
  statusLabel      String
  staffLogged      String
  staffRole        String?
  createdAt        DateTime @default(now())
}

model StaffAccount {
  id            String   @id @default(cuid())
  username      String   @unique
  passwordHash  String
  fullName      String
  email         String?
  phoneNumber   String?
  role          String   // Front Desk Staff, Gym Trainer, Shift Lead, Assistant Manager
  status        String   @default("Active")
  registeredAt  String
  registeredBy  String
  assignedShift String?
  permissions   String[]
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model MembershipExtensionLog {
  id                     String   @id @default(cuid())
  extendedAt             String
  timeFormatted          String
  monthsAdded            Int
  previousExpirationDate String
  newExpirationDate      String
  staffLogged            String?
  feePaid                Float?
  paymentMethod          String?
  memberCategory         String?
  memberId               String?
  memberName             String?
  createdAt              DateTime @default(now())

  member                 Member?  @relation(fields: [memberId], references: [id], onDelete: SetNull)
}
